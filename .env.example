# Copy to .env.local and replace every placeholder. Never commit real secrets.
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/euroblock_shift"
DIRECT_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/euroblock_shift"
NEXTAUTH_URL="http://localhost:3000"
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET"

