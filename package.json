{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "npx prisma generate",
    "build": "npx prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\"",
    "test:smoke:unauth": "node testing/smoke-unauth.mjs http://localhost:3000",
    "test:approvals": "node --test --test-isolation=none testing/approval-maintenance.test.mjs testing/approval-return-flow.test.mjs testing/y310-approval.test.mjs",
    "test:approvals:db": "node --import tsx --test --test-isolation=none testing/approval-maintenance.integration.test.mjs",
    "test:approvals:labels": "node --import tsx --test --test-isolation=none testing/approval-record-label.test.ts testing/approval-station-labels.test.mjs",
    "test:approvals:scope": "node --import tsx --test --test-isolation=none testing/approval-history.test.ts testing/approval-station-scope.test.mjs",
    "test:users:reject": "node --test --test-isolation=none testing/user-registration.test.mjs testing/user-reject-ui.test.mjs",
    "test:y180": "node --import tsx --test --test-isolation=none testing/y180-operation-rows.test.ts",
    "test:shift-start": "node --test --test-isolation=none testing/shift-duplicate-start.test.mjs",
    "test:theme": "node --import tsx --test --test-isolation=none testing/theme.test.ts",
    "test:handover-unsent": "node --import tsx --test --test-isolation=none testing/handover-unsent.test.ts",
    "test:handover-auto-accept": "node --test --test-isolation=none testing/handover-auto-accept.test.mjs",
    "test:handover-auto-accept:db": "node --import tsx --test --test-isolation=none testing/handover-auto-accept.integration.test.ts",
    "test:kpi-form-versions": "node --import tsx --test --test-isolation=none testing/kpi-form-versions.test.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@google/genai": "^1.17.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vercel/blob": "^1.1.1",
    "autoprefixer": "^10.5.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.40.0",
    "next": "^15.4.9",
    "next-auth": "^4.24.13",
    "node-firebird": "^2.3.2",
    "pg": "^8.21.0",
    "postcss": "^8.5.6",
    "prisma": "^7.7.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@fontsource/noto-sans": "^5.2.10",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}
