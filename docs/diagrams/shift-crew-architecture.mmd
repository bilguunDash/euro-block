---
title: Ээлжийн багаар хуваарь оноох — бүрэн архитектур (2026-07-29)
---
flowchart TD

%% ═══════════════════════════════════════════════════════════
%% 0 · НЭГ УДААГИЙН СУУРЬ ТОХИРГОО
%% ═══════════════════════════════════════════════════════════
subgraph SETUP["0 · СУУРЬ ТОХИРГОО — нэг удаа"]
  direction LR
  K1["<b>supervisorStationFor(station)</b><br/><i>lib/master-stations.ts</i><br/>━━━━━━━━━━<br/>ҮЯ-180 → ҮЯ-310 Засварын мастер<br/>ҮЯ-320 → ҮЯ-410 Цахилгааны мастер<br/><i>бусад бүгд</i> → ҮЯ-099 Ээлжийн мастер"]
  K2["<b>users.stationCode</b><br/>хүн бүрт ЗААВАЛ<br/>━━━━━━━━━━<br/>оператор → ҮЯ-1xx / ҮЯ-2xx<br/>мастер → ҮЯ-099/310/400/410"]
  K3["<b>Урьдчилан засах</b><br/>ҮЯ-400 isMasterStation = true<br/><i>одоо false — зөрчилтэй</i>"]
end

%% ═══════════════════════════════════════════════════════════
%% 1 · БАГИЙН БҮРЭЛДЭХҮҮН
%% ═══════════════════════════════════════════════════════════
subgraph CREW["1 · БАГИЙН БҮРЭЛДЭХҮҮН — ажилтан солигдох үед"]
  C1["Админ → Ээлжийн хуваарь хуудас<br/>Багийн бүрэлдэхүүн засварлагч"]
  C2["Хайлт + role шүүлт<br/>оператор ба мастер ХАМТ"]
  C3["Checkbox-оор олноор сонгоод<br/>'1-р ээлж болгох'"]
  C4["POST /api/users/shift-group<br/>{ userIds[], shiftGroup }"]
  C5[("users.shiftGroup<br/>'1' | '2' | '3' | null")]
  C6["AuditLog<br/>user_shift_group_changed"]

  C1 --> C2 --> C3 --> C4
  C4 --> C5
  C4 --> C6
end

%% ═══════════════════════════════════════════════════════════
%% 2 · ХУВААРЬ ОНООХ
%% ═══════════════════════════════════════════════════════════
subgraph SCHED["2 · ХУВААРЬ ОНООХ — сард 2-3 удаа"]
  P1["Баг = 1-р ээлж<br/>Огноо = 2026-08-01 .. 08-31<br/>Ээлж = Өдрийн + Шөнийн"]
  P2["Урьдчилсан харагдац<br/>N хүн × M өдөр × K ээлж = X мөр"]
  P3{"stationCode дутуу<br/>гишүүн байна уу?"}
  P4["⚠ Шар анхааруулга<br/>эдгээр хүн АЛГАСАГДАНА<br/><i>чимээгүй хаяхгүй</i>"]
  P5["POST /api/schedules/bulk-crew<br/><b>сервер тал · нэг transaction</b>"]
  P6{"role?"}
  P7[("operator_schedules<br/>өөрийн stationCode дээр")]
  P8[("master_schedules<br/>өөрийн мастер станц дээр")]
  P9["Мэдэгдэл shift_assigned<br/>дедуп 24 цаг"]

  P1 --> P2 --> P3
  P3 -->|"тийм"| P4 --> P5
  P3 -->|"үгүй"| P5
  P5 --> P6
  P6 -->|"operator"| P7
  P6 -->|"master"| P8
  P7 --> P9
  P8 --> P9
end

%% ═══════════════════════════════════════════════════════════
%% 3 · ЭЭЛЖ АЖИЛЛАХ ҮЕ
%% ═══════════════════════════════════════════════════════════
subgraph RUN["3 · ЭЭЛЖ АЖИЛЛАХ ҮЕ — хариуцах мастер тодорхойлох"]
  R1["Оператор ээлжээ эхлүүлнэ"]
  R2[("shifts мөр үүснэ")]
  R3["<b>resolveResponsibleMaster(shift)</b>"]
  R4["1 · supervisor =<br/>supervisorStationFor(shift.stationCode)"]
  R5["2 · master_schedules<br/>WHERE shiftDate + shiftType<br/>AND stationCode = supervisor"]
  R6{"олдсон уу?"}
  R7["3 · Fallback: users<br/>WHERE role = master<br/>AND shiftGroup = операторын баг<br/>AND stationCode = supervisor"]
  R8{"олдсон уу?"}
  R9["shiftMasterUid тодорхойлогдлоо"]
  R10["✖ Хариуцах мастер алга<br/>админд анхааруулга<br/><i>чимээгүй тасрахгүй</i>"]
  R11["Дамжлага хүлээлцэх<br/>handoverStage урсгал"]

  R1 --> R2 --> R3 --> R4 --> R5 --> R6
  R6 -->|"тийм"| R9
  R6 -->|"үгүй"| R7 --> R8
  R8 -->|"тийм"| R9
  R8 -->|"үгүй"| R10
  R9 --> R11
end

%% ═══════════════════════════════════════════════════════════
%% 4 · МАСТЕРЫН ХАРАХ ЭРХ
%% ═══════════════════════════════════════════════════════════
subgraph SCOPE["4 · МАСТЕРЫН ХАРАХ ЭРХ — эсрэг лавлагаа · ХАМГИЙН ЭМЗЭГ ОРЛУУЛАЛТ"]
  V1["Мастер dashboard нээнэ"]
  V2["visibleStations(master) =<br/>бүх станцаас ФИЛЬТР<br/>supervisorStationFor(s) == master.stationCode"]
  V3["ҮЯ-410 мастер → ҮЯ-320<br/>ҮЯ-310 мастер → ҮЯ-180<br/>ҮЯ-099 мастер → бусад бүгд"]
  V4["shifts WHERE stationCode IN (...)<br/>+ өөрийн станцын ээлжүүд"]

  V1 --> V2 --> V3 --> V4
end

%% ═══════════════════════════════════════════════════════════
%% ҮЕ ШАТНЫ ДАРААЛАЛ (үл үзэгдэх — зөвхөн байрлалд)
%% ═══════════════════════════════════════════════════════════
SETUP ~~~ CREW
CREW ~~~ SCHED
SCHED ~~~ RUN
RUN ~~~ SCOPE

