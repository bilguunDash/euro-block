# Copy this file to .env.local on the server and replace every placeholder.
# Keep .env.local private. Never add real credentials to the deploy ZIP.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/euroblock_shift"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/euroblock_shift"
NEXTAUTH_URL="https://YOUR_SERVER_URL"
NEXTAUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Configure these only when the corresponding integrations are used.
# ERP_BASE_URL=""
# ERP_LOGIN=""
# ERP_PASSWORD=""
# ERP_SYNC_SECRET=""
# ERP_SYNC_DEFAULT_PASSWORD=""
