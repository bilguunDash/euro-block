// ──────────────────────────────────────────────
// SortWorkRecord — Сорт бүртгэл (ҮЯ-190)
// ──────────────────────────────────────────────
model SortWorkRecord {
  id      String @id @default(uuid()) @db.Uuid

  // Header — РАМ оператор бөглөнө
  shiftNo         String  @default("")
  headerCNumber   String  @default("")  // Ц.дугаар → Firebird BATCH.ID
  headerPoured    String  @default("")
  headerCut       String  @default("")
  // Цутгасан/зүссэн ЦАГ. `headerPoured`/`headerCut` нь зөвхөн ЭЭЛЖ (Өдрийн/Шөнийн)
  // хадгалдаг тул Excel экспортын «Цутгасан цаг»/«Зүссэн цаг» багана дүүргэх эх
  // сурвалжгүй, үргэлж хоосон гардаг байв. UTC-ээр хадгална (харуулахдаа UTC+8).
  // Хуучин бүртгэлд байхгүй тул nullable — заавал бөглөх талбар биш.
  pouredAt        DateTime?
  cutAt           DateTime?
  autoclaveNo     String  @default("")
  sort1FrameNo    String  @default("")
  sort1SizeMm     String  @default("")
  sort1Desc       String  @default("")
  ramDefectCode   String  @default("") // РАМ операторын урьдчилан сонгосон алдааны код (заавал биш)
  specialDualMode Boolean @default(false)

  // Sort1 — СОРТ оператор бөглөнө
  sort1CutMm  String @default("")
  sort1Qty    Int    @default(0)
  sort1M3     Float  @default(0)
  sort1Qty200 Int    @default(0)
  sort1M3200  Float  @default(0)
  sort1Qty100 Int    @default(0)
  sort1M3100  Float  @default(0)

  // Sort2
  sort2Code   String @default("")
  sort2CutMm  String @default("")
  sort2Qty    Int    @default(0)
  sort2M3     Float  @default(0)
  sort2Desc   String @default("")
  sort2Qty200 Int    @default(0)
  sort2M3200  Float  @default(0)
  sort2Qty100 Int    @default(0)
  sort2M3100  Float  @default(0)

  // Sort3
  sort3Code   String @default("")
  sort3CutMm  String @default("")
  sort3Qty    Int    @default(0)
  sort3M3     Float  @default(0)
  sort3Desc   String @default("")
  sort3Qty200 Int    @default(0)
  sort3M3200  Float  @default(0)
  sort3Qty100 Int    @default(0)
  sort3M3100  Float  @default(0)

  // Дутагдал
  deficitCutMm  String @default("")
  deficitQty    Int    @default(0)
  deficitM3     Float  @default(0)
  deficitDesc   String @default("")
  deficitQty200 Int    @default(0)
  deficitM3200  Float  @default(0)
  deficitQty100 Int    @default(0)
  deficitM3100  Float  @default(0)

  // Төлөв ба операторын мэдээлэл
  status        String   @default("draft")  // draft | waiting_sort | completed | deleted
  createdByUid  String
  createdByName String?
  sortedByUid   String?
  sortedByName  String?
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([headerCNumber])
  @@index([shiftNo])
  @@index([status, createdAt])
  @@index([createdByUid])
  @@map("sort_work_records")
}
